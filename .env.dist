# mend — example environment configuration.
#
# Copy to `.env` for local use (it's git-ignored), or set these as variables in
# your host/Railway dashboard. Every value here is also a sensible default, so the
# app runs with NONE of these set — but you'll want AUTH_PASSWORD before exposing
# it, and at least an Anthropic key (here or in-app at /settings) for AI features.

# --- Server -----------------------------------------------------------------
# Listen address. PORT (just the number) is honored first and is set automatically
# by Railway/most PaaS; ADDR is the full "host:port" form for local control.
# PORT=8080
# ADDR=:8080

# Display timezone for auto-stamped "created" times (an IANA name). Defaults to
# UTC. Times you type into a date/time picker are kept exactly as entered.
# TZ=America/Chicago

# --- Storage ----------------------------------------------------------------
# SQLite database file and the on-disk blob dir (uploads + audio recordings).
# On Railway, mount a volume and point both at it (e.g. /data) so data persists.
# The Docker image already defaults these to /data.
# DB_PATH=data/mend.db
# DATA_DIR=data

# --- Authentication ---------------------------------------------------------
# Set AUTH_PASSWORD to require a login (single shared password). Leave unset for
# local dev to disable auth entirely. SESSION_SECRET signs the session cookie;
# set a long random string so logins survive restarts (otherwise it's derived
# from the password). Generate one with: openssl rand -hex 32
AUTH_PASSWORD=
SESSION_SECRET=

# --- AI (Anthropic) ---------------------------------------------------------
# Optional here — can also be set in-app at /settings (stored in the DB).
# An in-app setting overrides the env value.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-4-8

# --- Transcription (Whisper-class, OpenAI-compatible) -----------------------
# Optional. Any OpenAI-compatible /audio/transcriptions endpoint works.
# Also settable in-app at /settings.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1
