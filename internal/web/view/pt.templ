package view

import "github.com/tylersriver/mend/internal/store"

var metricTypes = []string{"strength", "band", "hold", "mobility"}
var exerciseCategories = []string{"rotator_cuff", "scapular", "mobility", "compound"}

// PTHub is the satellite's landing page: PT is secondary to the care spine, so it
// lives behind one nav entry that fans out to sessions, exercises, and metrics.
templ PTHub(profile store.CaseProfile, recent []store.Session, exerciseCount, protocolCount int, activeProtocol string) {
	@Layout("PT", profile) {
		@pageHeader("Physical therapy") {
			@btnLink("/pt/sessions/new", "+ Log session")
		}
		<div class="grid grid-cols-2 gap-2 mb-6 text-center">
			@hubTile("/pt/sessions", "Sessions", "log & history")
			@hubTile("/pt/protocols", "Protocols", protocolSub(protocolCount, activeProtocol))
			@hubTile("/pt/exercises", "Exercises", itoaInt(exerciseCount))
			@hubTile("/pt/measurements", "Metrics", "charts")
		</div>
		<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-2">Recent sessions</h2>
		if len(recent) == 0 {
			<p class="text-sm text-slate-400">No sessions logged yet. Log your first PT bout to start tracking.</p>
		} else {
			<ul class="space-y-2">
				for _, se := range recent {
					@sessionRow(se)
				}
			</ul>
		}
	}
}

templ hubTile(href, title, sub string) {
	<a href={ templ.SafeURL(href) } class="block bg-white rounded-2xl border border-slate-200 p-4 hover:border-teal-300">
		<div class="font-medium text-slate-900">{ title }</div>
		<div class="text-xs text-slate-400 mt-1">{ sub }</div>
	</a>
}

templ sessionRow(se store.Session) {
	<li>
		<a href={ templ.SafeURL(ptURL("sessions", se.ID)) } class="block bg-white rounded-2xl border border-slate-200 p-3 hover:border-teal-300">
			<div class="flex justify-between items-center">
				<span class="font-medium">{ humanTime(se.PerformedAt) }</span>
				<span class="text-xs text-slate-500">{ itoaInt(se.SetCount) } sets</span>
			</div>
			if se.PainPre != nil || se.PainPost != nil {
				<span class="text-xs text-slate-500">pain { ptInt(se.PainPre) } → { ptInt(se.PainPost) }</span>
			}
		</a>
	</li>
}

// --- Exercises --------------------------------------------------------------

templ ExerciseList(profile store.CaseProfile, exercises []store.Exercise) {
	@Layout("Exercises", profile) {
		@pageHeader("Exercises") {
			@btnLink("/pt/exercises/new", "+ New")
		}
		if len(exercises) == 0 {
			<p class="text-sm text-slate-400">No exercises yet. Add the movements your protocol prescribes.</p>
		} else {
			<ul class="space-y-2">
				for _, e := range exercises {
					<li class={ "bg-white rounded-2xl border border-slate-200 p-3 " + archivedCls(e.IsArchived) }>
						<div class="flex justify-between items-center">
							<span class="font-medium">{ e.Name }</span>
							<span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">{ label(e.MetricType) }</span>
						</div>
						<div class="flex justify-between items-end mt-1">
							<div class="text-xs text-slate-500">
								if e.Category != "" {
									<span>{ label(e.Category) }</span>
								}
								if e.Cues != "" {
									<p class="mt-1">{ e.Cues }</p>
								}
								if e.DemoURL != "" {
									<a href={ templ.SafeURL(e.DemoURL) } target="_blank" rel="noopener" class="text-teal-700 underline">demo</a>
								}
							</div>
							<form method="post" action={ templ.SafeURL(ptURL("exercises", e.ID) + "/archive") }>
								<input type="hidden" name="archived" value={ toggleArchived(e.IsArchived) }/>
								<button class="text-xs text-slate-500 underline">
									if e.IsArchived {
										Unarchive
									} else {
										Archive
									}
								</button>
							</form>
						</div>
					</li>
				}
			</ul>
		}
	}
}

templ ExerciseForm(profile store.CaseProfile) {
	@Layout("New exercise", profile) {
		@pageHeader("New exercise") {
		}
		@card() {
			<form method="post" action="/pt/exercises" class="space-y-4">
				<div>
					<label class="block text-xs font-medium text-slate-500">Name</label>
					<input name="name" required class={ inputCls }/>
				</div>
				<div class="flex gap-3">
					<div class="flex-1">
						<label class="block text-xs font-medium text-slate-500">Metric type</label>
						<select name="metric_type" class={ inputCls }>
							for _, m := range metricTypes {
								<option value={ m }>{ label(m) }</option>
							}
						</select>
					</div>
					<div class="flex-1">
						<label class="block text-xs font-medium text-slate-500">Category</label>
						<select name="category" class={ inputCls }>
							<option value="">—</option>
							for _, c := range exerciseCategories {
								<option value={ c }>{ label(c) }</option>
							}
						</select>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500">Cues</label>
					<textarea name="cues" rows="2" class={ inputCls } placeholder="form notes to self"></textarea>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500">Demo URL</label>
					<input name="demo_url" type="url" class={ inputCls }/>
				</div>
				<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Save</button>
			</form>
		}
	}
}

// --- Sessions ---------------------------------------------------------------

templ SessionList(profile store.CaseProfile, sessions []store.Session) {
	@Layout("Sessions", profile) {
		@pageHeader("Sessions") {
			@btnLink("/pt/sessions/new", "+ Log")
		}
		if len(sessions) == 0 {
			<p class="text-sm text-slate-400">No sessions logged yet.</p>
		} else {
			<ul class="space-y-2">
				for _, se := range sessions {
					@sessionRow(se)
				}
			</ul>
		}
	}
}

templ SessionForm(profile store.CaseProfile) {
	@Layout("Log session", profile) {
		@pageHeader("Log session") {
		}
		@card() {
			<form method="post" action="/pt/sessions" class="space-y-4">
				<div class="flex gap-3">
					<div class="flex-1">
						<label class="block text-xs font-medium text-slate-500">When</label>
						<input type="datetime-local" name="performed_at" class={ inputCls }/>
					</div>
					<div class="flex-1">
						<label class="block text-xs font-medium text-slate-500">Duration (min)</label>
						<input type="number" name="duration_min" min="0" class={ inputCls }/>
					</div>
				</div>
				<div class="flex gap-3">
					<div class="flex-1">
						<label class="block text-xs font-medium text-slate-500">Pain before (0–10)</label>
						<input type="number" name="pain_pre" min="0" max="10" class={ inputCls }/>
					</div>
					<div class="flex-1">
						<label class="block text-xs font-medium text-slate-500">Pain after (0–10)</label>
						<input type="number" name="pain_post" min="0" max="10" class={ inputCls }/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500">Notes</label>
					<textarea name="notes" rows="2" class={ inputCls }></textarea>
				</div>
				<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Create &amp; log sets</button>
			</form>
		}
	}
}

templ SessionDetail(profile store.CaseProfile, se store.Session, exercises []store.Exercise) {
	@Layout("Session", profile) {
		<div class="flex items-center justify-between mb-4">
			<div>
				<h1 class="text-xl font-semibold text-slate-900">{ humanTime(se.PerformedAt) }</h1>
				if se.ProtocolName != "" {
					<a href={ templ.SafeURL(ptURL("protocols", *se.ProtocolID)) } class="text-xs text-teal-700 underline">{ se.ProtocolName }</a>
				}
			</div>
			<form method="post" action={ templ.SafeURL(ptURL("sessions", se.ID) + "/delete") } onsubmit="return confirm('Delete this session and its sets?')">
				<button class="text-xs text-red-600 underline">Delete</button>
			</form>
		</div>
		<section class="mb-6">
			@card() {
				<form method="post" action={ templ.SafeURL(ptURL("sessions", se.ID)) } class="space-y-3">
					<div class="flex gap-3">
						<div class="flex-1">
							<label class="block text-xs font-medium text-slate-500">Duration (min)</label>
							<input type="number" name="duration_min" min="0" value={ ptIntVal(se.DurationMin) } class={ inputCls }/>
						</div>
						<div class="flex-1">
							<label class="block text-xs font-medium text-slate-500">Pain before</label>
							<input type="number" name="pain_pre" min="0" max="10" value={ ptIntVal(se.PainPre) } class={ inputCls }/>
						</div>
						<div class="flex-1">
							<label class="block text-xs font-medium text-slate-500">Pain after</label>
							<input type="number" name="pain_post" min="0" max="10" value={ ptIntVal(se.PainPost) } class={ inputCls }/>
						</div>
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-500">Notes</label>
						<textarea name="notes" rows="2" class={ inputCls }>{ se.Notes }</textarea>
					</div>
					<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Save</button>
				</form>
			}
		</section>
		<section>
			<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-2">Sets</h2>
			if len(exercises) == 0 {
				<p class="text-sm text-slate-400 mb-3">Add an <a href="/pt/exercises/new" class="underline">exercise</a> first to log sets.</p>
			}
			<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden mb-4">
				<table class="w-full text-sm">
					<tbody id="sets-tbody">
						for _, st := range se.Sets {
							@SetRow(st)
						}
					</tbody>
				</table>
			</div>
			if len(exercises) > 0 {
				@addSetForm(se.ID, exercises)
			}
		</section>
	}
}

// SetRow is one logged set; also returned standalone over htmx when a set is added.
templ SetRow(st store.Set) {
	<tr class="border-t border-slate-100">
		<td class="px-3 py-2">
			<div class="font-medium">{ st.ExerciseName } <span class="text-xs text-slate-400">#{ itoa(st.SetNumber) }</span></div>
			<div class="text-xs text-slate-500">{ setSummary(st) }</div>
			if st.Notes != "" {
				<div class="text-xs text-slate-400">{ st.Notes }</div>
			}
		</td>
		<td class="px-3 py-2 text-right align-top">
			<button
				hx-post={ ptURL("sets", st.ID) + "/delete" }
				hx-target="closest tr"
				hx-swap="outerHTML"
				class="text-xs text-red-600 underline"
			>remove</button>
		</td>
	</tr>
}

templ addSetForm(sessionID int64, exercises []store.Exercise) {
	<form
		hx-post={ ptURL("sessions", sessionID) + "/sets" }
		hx-target="#sets-tbody"
		hx-swap="beforeend"
		class="bg-white rounded-2xl border border-slate-200 p-3 space-y-3"
		data-set-form
	>
		<div>
			<label class="block text-xs font-medium text-slate-500">Exercise</label>
			<select name="exercise_id" class={ inputCls } data-exercise>
				for _, e := range exercises {
					<option value={ itoa(e.ID) } data-metric={ e.MetricType }>{ e.Name }</option>
				}
			</select>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<div data-field="reps">
				<label class="block text-xs font-medium text-slate-500">Reps</label>
				<input type="number" name="reps" min="0" class={ inputCls }/>
			</div>
			<div data-field="load">
				<label class="block text-xs font-medium text-slate-500">Load (lb)</label>
				<input type="number" name="load" step="0.5" class={ inputCls }/>
			</div>
			<div data-field="duration">
				<label class="block text-xs font-medium text-slate-500">Duration (s)</label>
				<input type="number" name="duration_sec" min="0" class={ inputCls }/>
			</div>
			<div data-field="rom">
				<label class="block text-xs font-medium text-slate-500">ROM (°)</label>
				<input type="number" name="rom_degrees" step="1" class={ inputCls }/>
			</div>
			<div data-field="resistance">
				<label class="block text-xs font-medium text-slate-500">Band / resistance</label>
				<input name="resistance" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500">RPE</label>
				<input type="number" name="rpe" step="0.5" min="0" max="10" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500">Pain (0–10)</label>
				<input type="number" name="pain" min="0" max="10" class={ inputCls }/>
			</div>
			<div class="col-span-2">
				<label class="block text-xs font-medium text-slate-500">Notes</label>
				<input name="notes" class={ inputCls }/>
			</div>
		</div>
		<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Add set</button>
	</form>
	@setFormScript()
}

// setFormScript shows only the metric fields relevant to the selected exercise.
templ setFormScript() {
	<script>
		(function () {
			const form = document.querySelector('[data-set-form]');
			if (!form) return;
			const sel = form.querySelector('[data-exercise]');
			const map = { strength: ['reps','load'], band: ['resistance','reps'], hold: ['duration'], mobility: ['rom','reps'] };
			function sync() {
				const opt = sel.options[sel.selectedIndex];
				const metric = opt ? opt.getAttribute('data-metric') : '';
				const show = map[metric] || ['reps','load','duration','rom','resistance'];
				form.querySelectorAll('[data-field]').forEach(el => {
					el.style.display = show.includes(el.getAttribute('data-field')) ? '' : 'none';
				});
			}
			sel.addEventListener('change', sync);
			sync();
		})();
	</script>
}

// --- Measurements -----------------------------------------------------------

var commonMetrics = []string{"pain_daily", "rom_flexion", "rom_external_rot", "grip_strength"}

templ MeasurementList(profile store.CaseProfile, series map[string][]store.Measurement, order []string, recent []store.Measurement) {
	@Layout("Metrics", profile) {
		@pageHeader("Metrics") {
		}
		<section class="mb-6">
			@card() {
				<form method="post" action="/pt/measurements" class="space-y-3">
					<div class="flex gap-3">
						<div class="flex-1">
							<label class="block text-xs font-medium text-slate-500">Metric</label>
							<input name="metric" list="metric-list" required placeholder="pain_daily" class={ inputCls }/>
							<datalist id="metric-list">
								for _, m := range commonMetrics {
									<option value={ m }></option>
								}
							</datalist>
						</div>
						<div class="w-24">
							<label class="block text-xs font-medium text-slate-500">Value</label>
							<input name="value" type="number" step="any" required class={ inputCls }/>
						</div>
					</div>
					<div class="flex gap-3">
						<div class="flex-1">
							<label class="block text-xs font-medium text-slate-500">Unit</label>
							<input name="unit" placeholder="deg · lbs · 0-10" class={ inputCls }/>
						</div>
						<div class="flex-1">
							<label class="block text-xs font-medium text-slate-500">Side</label>
							<select name="side" class={ inputCls }>
								<option value="">—</option>
								<option value="left">Left</option>
								<option value="right">Right</option>
							</select>
						</div>
						<div class="flex-1">
							<label class="block text-xs font-medium text-slate-500">When</label>
							<input type="date" name="measured_at" class={ inputCls }/>
						</div>
					</div>
					<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Add measurement</button>
				</form>
			}
		</section>
		if len(order) > 0 {
			<section class="mb-6">
				<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-2">Trends</h2>
				<div class="space-y-3">
					for _, metric := range order {
						@card() {
							<div class="flex justify-between items-baseline mb-1">
								<span class="font-medium text-sm">{ label(metric) }</span>
								<span class="text-xs text-slate-400">{ latestValue(series[metric]) }</span>
							</div>
							@sparkline(series[metric])
						}
					}
				</div>
			</section>
		}
		<section>
			<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-2">Log</h2>
			if len(recent) == 0 {
				<p class="text-sm text-slate-400">No measurements yet.</p>
			} else {
				<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
					<table class="w-full text-sm">
						<tbody>
							for _, m := range recent {
								<tr class="border-t border-slate-100 first:border-t-0">
									<td class="px-3 py-2">
										<div class="font-medium">{ label(m.Metric) } { sideSuffix(m.Side) }</div>
										<div class="text-xs text-slate-400">{ humanTime(m.MeasuredAt) }</div>
									</td>
									<td class="px-3 py-2 text-right whitespace-nowrap">{ measureValue(m) }</td>
									<td class="px-3 py-2 text-right">
										<form method="post" action={ templ.SafeURL(ptURL("measurements", m.ID) + "/delete") }>
											<button class="text-xs text-red-600 underline">remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}
