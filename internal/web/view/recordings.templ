package view

import "github.com/tylersriver/mend/internal/store"

templ RecordingList(profile store.CaseProfile, recs []store.Recording, transcribeEnabled bool) {
	@Layout("Recordings", profile) {
		@pageHeader("Recordings") {
			@btnLink("/recordings/new", "+ New")
		}
		if !transcribeEnabled {
			<div class="mb-4">
				@flash("warn", "Transcription is not configured — set TRANSCRIBE_API_KEY. You can still upload audio; transcripts won't generate until it's set.")
			</div>
		}
		if len(recs) == 0 {
			<p class="text-sm text-slate-400 dark:text-slate-500">No recordings yet. Record or upload an appointment to get a transcript, highlights, and a task list.</p>
		} else {
			<ul class="space-y-2">
				for _, r := range recs {
					<li>
						<a href={ templ.SafeURL(recordingURL(r.ID)) } class="block bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-3 hover:border-teal-300 dark:hover:border-teal-700">
							<div class="flex justify-between items-center">
								<span class="font-medium">{ recordingLabel(r) }</span>
								<span class={ "text-xs px-2 py-0.5 rounded-full " + recStatusClasses(r.TranscriptStatus) }>{ label(r.TranscriptStatus) }</span>
							</div>
							<span class="text-xs text-slate-500 dark:text-slate-400">{ humanTime(r.CreatedAt) }</span>
						</a>
					</li>
				}
			</ul>
		}
	}
}

templ RecordingForm(profile store.CaseProfile, appts []store.Appointment, selected int64, transcribeEnabled bool) {
	@Layout("New recording", profile) {
		@pageHeader("New recording") {
		}
		@card() {
			<form method="post" action="/recordings" enctype="multipart/form-data" class="space-y-4">
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Link to appointment</label>
					<select name="appointment_id" class={ inputCls }>
						<option value="0">— none —</option>
						for _, a := range appts {
							if a.ID == selected {
								<option value={ itoa(a.ID) } selected>{ apptOption(a) }</option>
							} else {
								<option value={ itoa(a.ID) }>{ apptOption(a) }</option>
							}
						}
					</select>
				</div>
				<!-- In-browser recorder (MediaRecorder). Falls back to the file input below. -->
				<div class="rounded-xl border border-slate-200 dark:border-slate-800 p-3">
					<div class="flex items-center gap-3">
						<button type="button" id="rec-toggle" class="px-3 py-2 bg-rose-600 text-white text-sm rounded-xl hover:bg-rose-700">● Record</button>
						<span id="rec-timer" class="text-sm text-slate-500 dark:text-slate-400 tabular-nums">0:00</span>
						<audio id="rec-preview" controls class="hidden ml-auto"></audio>
					</div>
					<p id="rec-msg" class="text-xs text-slate-400 dark:text-slate-500 mt-2">Tap Record to capture audio. It will attach below automatically.</p>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Or upload an audio file</label>
					<input id="audio-input" name="audio" type="file" accept="audio/*" class={ inputCls }/>
				</div>
				<input type="hidden" id="duration-input" name="duration_sec" value="0"/>
				<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Save recording</button>
				if transcribeEnabled {
					<p class="text-xs text-slate-400 dark:text-slate-500">After saving, transcription runs automatically and the page will update.</p>
				}
			</form>
		}
		<p class="text-xs text-slate-400 dark:text-slate-500 mt-3">
			Recording your own visit is legal in one-party-consent states, but a quick
			"mind if I record this for my notes?" is the courteous habit. Audio is the
			most sensitive data here — you can delete the audio once a transcript exists.
		</p>
		@recorderScript()
	}
}

templ RecordingDetail(profile store.CaseProfile, r store.Recording, docs []store.AIDoc, transcribeEnabled, aiEnabled bool) {
	@Layout("Recording", profile) {
		<div class="flex items-center justify-between mb-4">
			<div>
				<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ recordingLabel(r) }</h1>
				<p class="text-sm text-slate-500 dark:text-slate-400">{ humanTime(r.CreatedAt) }</p>
			</div>
			<form method="post" action={ templ.SafeURL(recordingURL(r.ID) + "/delete") } onsubmit="return confirm('Delete this recording and its audio?')">
				<button class="text-xs text-red-600 underline">Delete</button>
			</form>
		</div>
		if r.AudioPath != "" {
			<div class="mb-4 flex items-center gap-3">
				<audio controls src={ recordingURL(r.ID) + "/audio" } class="w-full"></audio>
				<form method="post" action={ templ.SafeURL(recordingURL(r.ID) + "/audio/delete") } onsubmit="return confirm('Delete the audio file? The transcript is kept.')">
					<button class="text-xs text-red-600 underline whitespace-nowrap">Delete audio</button>
				</form>
			</div>
		}
		@RecordingStatus(r, docs, transcribeEnabled, aiEnabled)
	}
}

// RecordingStatus is the live region: it polls itself over htmx while the pipeline
// is active, and renders the transcript + AI documents once done.
templ RecordingStatus(r store.Recording, docs []store.AIDoc, transcribeEnabled, aiEnabled bool) {
	<div
		id="rec-status"
		if recActive(r.TranscriptStatus) && transcribeEnabled {
			hx-get={ recordingURL(r.ID) + "/status" }
			hx-trigger="load delay:2s"
			hx-swap="outerHTML"
		}
	>
		<div class="flex items-center gap-2 mb-3">
			<span class={ "text-xs px-2 py-0.5 rounded-full " + recStatusClasses(r.TranscriptStatus) }>{ label(r.TranscriptStatus) }</span>
			if r.TranscriptStatus == "processing" {
				<span class="text-sm text-slate-400 dark:text-slate-500">Transcribing… this can take a minute.</span>
			}
			if r.TranscriptStatus == "pending" && transcribeEnabled {
				<span class="text-sm text-slate-400 dark:text-slate-500">Queued…</span>
			}
			if r.TranscriptStatus == "pending" && !transcribeEnabled {
				<span class="text-sm text-slate-400 dark:text-slate-500">Transcription not configured.</span>
			}
		</div>
		if r.TranscriptStatus == "failed" {
			<div class="mb-3">
				@flash("error", "Transcription failed.")
			</div>
		}
		if transcribeEnabled && (r.TranscriptStatus == "failed" || (r.TranscriptStatus == "pending" && r.AudioPath != "")) {
			<form method="post" action={ templ.SafeURL(recordingURL(r.ID) + "/transcribe") } class="mb-4">
				<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Transcribe now</button>
			</form>
		}
		if r.Transcript != "" {
			<section class="mb-6">
				<h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Transcript</h2>
				@card() {
					<p class="whitespace-pre-wrap text-sm leading-relaxed">{ r.Transcript }</p>
				}
			</section>
			<section>
				<div class="flex items-center justify-between mb-2">
					<h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Highlights & tasks</h2>
					if aiEnabled && len(docs) == 0 {
						<form method="post" action={ templ.SafeURL(recordingURL(r.ID) + "/summarize") }>
							<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Generate</button>
						</form>
					}
				</div>
				if len(docs) == 0 {
					if aiEnabled {
						<p class="text-sm text-slate-400 dark:text-slate-500">No AI documents yet — generate highlights and a task list from this transcript.</p>
					} else {
						<p class="text-sm text-slate-400 dark:text-slate-500">Set ANTHROPIC_API_KEY to generate highlights and tasks.</p>
					}
				} else {
					<div class="space-y-3">
						for _, d := range docs {
							@AIDocCard(d)
						}
					</div>
				}
			</section>
		}
	</div>
}

// recorderScript holds the vanilla MediaRecorder logic. Kept inline (no build step).
templ recorderScript() {
	<script>
		(function () {
			const toggle = document.getElementById('rec-toggle');
			if (!toggle || !navigator.mediaDevices || !window.MediaRecorder) {
				if (toggle) { toggle.disabled = true; }
				const msg = document.getElementById('rec-msg');
				if (msg) { msg.textContent = 'In-browser recording is unavailable here — upload a file instead.'; }
				return;
			}
			const timer = document.getElementById('rec-timer');
			const preview = document.getElementById('rec-preview');
			const fileInput = document.getElementById('audio-input');
			const durationInput = document.getElementById('duration-input');
			let recorder, chunks = [], startedAt = 0, tick, wakeLock = null;

			function fmt(s) {
				const m = Math.floor(s / 60), r = s % 60;
				return m + ':' + String(r).padStart(2, '0');
			}

			async function start() {
				const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
				recorder = new MediaRecorder(stream);
				chunks = [];
				recorder.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
				recorder.onstop = () => {
					const blob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
					const ext = (blob.type.split('/')[1] || 'webm').split(';')[0];
					const file = new File([blob], 'recording.' + ext, { type: blob.type });
					const dt = new DataTransfer();
					dt.items.add(file);
					fileInput.files = dt.files;
					preview.src = URL.createObjectURL(blob);
					preview.classList.remove('hidden');
					durationInput.value = Math.round((Date.now() - startedAt) / 1000);
					stream.getTracks().forEach(t => t.stop());
					if (wakeLock) { wakeLock.release().catch(() => {}); wakeLock = null; }
				};
				recorder.start();
				startedAt = Date.now();
				tick = setInterval(() => { timer.textContent = fmt(Math.round((Date.now() - startedAt) / 1000)); }, 500);
				try { wakeLock = await navigator.wakeLock.request('screen'); } catch (e) {}
				toggle.textContent = '■ Stop';
				toggle.classList.replace('bg-rose-600', 'bg-slate-700');
				document.getElementById('rec-msg').textContent = 'Recording… tap Stop when done.';
			}

			function stop() {
				if (recorder && recorder.state !== 'inactive') recorder.stop();
				clearInterval(tick);
				toggle.textContent = '● Record';
				toggle.classList.replace('bg-slate-700', 'bg-rose-600');
				document.getElementById('rec-msg').textContent = 'Captured. It will attach when you save.';
			}

			toggle.addEventListener('click', () => {
				if (!recorder || recorder.state === 'inactive') {
					start().catch(err => { document.getElementById('rec-msg').textContent = 'Mic error: ' + err.message; });
				} else {
					stop();
				}
			});
		})();
	</script>
}
