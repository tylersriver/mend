package view

import "github.com/tylersriver/mend/internal/store"

var resourceKinds = []string{"link", "video", "file"}

templ ResourceList(profile store.CaseProfile, resources []store.Resource) {
	@Layout("Research", profile) {
		@pageHeader("Research") {
			@btnLink("/resources/new", "+ Add")
		}
		if len(resources) == 0 {
			<p class="text-sm text-slate-400 dark:text-slate-500">No research saved. Add articles, videos, or files to build your case file.</p>
		} else {
			<ul class="space-y-2">
				for _, r := range resources {
					<li>
						<a href={ templ.SafeURL(resourceURL(r.ID)) } class="block bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-3 hover:border-teal-300 dark:hover:border-teal-700">
							<div class="flex justify-between items-center">
								<span class="font-medium">{ r.Title }</span>
								<span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">{ label(r.Kind) }</span>
							</div>
							if r.Summary != "" {
								<p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">{ r.Summary }</p>
							}
						</a>
					</li>
				}
			</ul>
		}
	}
}

templ ResourceForm(profile store.CaseProfile) {
	@Layout("Add research", profile) {
		@pageHeader("Add research") {
		}
		@card() {
			<form method="post" action="/resources" enctype="multipart/form-data" class="space-y-4">
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Type</label>
					<select name="kind" class={ inputCls }>
						for _, k := range resourceKinds {
							<option value={ k }>{ label(k) }</option>
						}
					</select>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Title</label>
					<input name="title" required class={ inputCls }/>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">URL <span class="text-slate-400 dark:text-slate-500">(for link/video)</span></label>
					<input name="url" type="url" class={ inputCls }/>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">File <span class="text-slate-400 dark:text-slate-500">(for file)</span></label>
					<input name="file" type="file" class={ inputCls }/>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Source</label>
					<input name="source" placeholder="youtube · pubmed · clinic · reddit" class={ inputCls }/>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Notes / summary</label>
					<textarea name="summary" rows="4" class={ inputCls } placeholder="Paste the abstract or your notes; the AI can condense this later. For a link or YouTube video you can leave this blank — AI summarize reads the page or transcript."></textarea>
				</div>
				<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Save</button>
			</form>
		}
	}
}

templ ResourceDetail(profile store.CaseProfile, r store.Resource, aiEnabled bool) {
	@Layout(r.Title, profile) {
		<!-- read view by default; the edit pencil opens the form (CSS-only, like
		     the appointment notes editor). -->
		<input type="checkbox" id="edit-res" class="peer hidden"/>
		<div class="flex items-start justify-between gap-3 mb-4">
			<div class="min-w-0">
				<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100 break-words">{ r.Title }</h1>
				<p class="text-sm text-slate-500 dark:text-slate-400">{ label(r.Kind) }{ sourceSuffix(r) }</p>
			</div>
			<form method="post" action={ templ.SafeURL(resourceURL(r.ID) + "/delete") } onsubmit="return confirm('Delete this resource?')" class="shrink-0">
				<button class="text-xs text-red-600 underline">Delete</button>
			</form>
		</div>
		if r.URL != "" {
			<p class="mb-4 peer-checked:hidden"><a href={ templ.SafeURL(r.URL) } target="_blank" rel="noopener" class="text-teal-700 dark:text-teal-400 underline break-all">{ r.URL }</a></p>
		}
		if r.FilePath != "" {
			<p class="mb-4 peer-checked:hidden"><a href={ templ.SafeURL(resourceURL(r.ID) + "/file") } class="text-teal-700 dark:text-teal-400 underline">Download file</a></p>
		}
		<!-- edit form (shown when the pencil is toggled) -->
		<div class="hidden peer-checked:block mb-6">
			@card() {
				<div class="flex items-center justify-between mb-3">
					<h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Edit research item</h2>
					<label for="edit-res" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 cursor-pointer">Cancel</label>
				</div>
				<form method="post" action={ templ.SafeURL(resourceURL(r.ID)) } class="space-y-4">
					<div>
						<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Title</label>
						<input name="title" value={ r.Title } required class={ inputCls }/>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						<div class="min-w-0">
							<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">URL</label>
							<input name="url" type="url" value={ r.URL } class={ inputCls }/>
						</div>
						<div class="min-w-0">
							<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Source</label>
							<input name="source" value={ r.Source } placeholder="youtube · pubmed · clinic" class={ inputCls }/>
						</div>
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Notes / summary</label>
						<textarea id="res-summary-input" name="summary" rows="8" class={ inputCls } placeholder="Add your own notes, or adjust the AI-generated summary.">{ r.Summary }</textarea>
					</div>
					<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Save</button>
				</form>
			}
		</div>
		<!-- read view of the summary -->
		<section class="peer-checked:hidden">
			<div class="flex items-center justify-between gap-2 mb-2">
				<h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Summary &amp; notes</h2>
				<div class="flex items-center gap-2 shrink-0">
					if aiEnabled {
						<button
							hx-post={ resourceURL(r.ID) + "/summarize" }
							hx-target="#summary-body"
							hx-swap="innerHTML"
							hx-indicator="#sum-spin"
							class="px-3 py-1.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition"
						>AI summarize</button>
					}
					<label for="edit-res" class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-teal-700 dark:text-teal-400 rounded-xl hover:bg-teal-50 dark:hover:bg-slate-800 cursor-pointer transition">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
						</svg>
						Edit
					</label>
				</div>
			</div>
			<div id="sum-spin" class="htmx-indicator text-sm text-slate-400 dark:text-slate-500 mb-2">Summarizing…</div>
			@card() {
				<div id="summary-body" class="prose prose-sm max-w-none dark:prose-invert">
					@SummaryBody(r.Summary)
				</div>
			}
		</section>
	}
}

// SummaryBody is the swappable summary region (returned standalone after AI summarize).
templ SummaryBody(summary string) {
	if summary == "" {
		<p class="text-sm text-slate-400 dark:text-slate-500">No summary yet.</p>
	} else {
		@Markdown(summary)
	}
}

// SummaryUpdated is returned after an AI summarize: it fills the read view and,
// out-of-band, syncs the edit form's textarea so "adjust the summary" picks up the
// freshly generated text without a reload.
templ SummaryUpdated(summary string) {
	@SummaryBody(summary)
	<textarea id="res-summary-input" name="summary" rows="8" class={ inputCls } hx-swap-oob="true">{ summary }</textarea>
}
