package view

// LoginPage is a standalone page (no app nav) shown when auth is required.
templ LoginPage(failed bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#0f766e"/>
			<title>Sign in · mend</title>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<script src="https://cdn.tailwindcss.com"></script>
		</head>
		<body class="bg-slate-50 min-h-screen flex items-center justify-center p-6">
			<div class="w-full max-w-sm">
				<div class="text-center mb-6">
					<div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-teal-700 text-white text-3xl font-bold">+</div>
					<h1 class="mt-3 text-xl font-semibold text-slate-900">mend</h1>
					<p class="text-sm text-slate-500">Sign in to continue</p>
				</div>
				<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-5">
					if failed {
						<div class="mb-3 rounded-md bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2">
							Incorrect password.
						</div>
					}
					<form method="post" action="/login" class="space-y-3">
						<div>
							<label class="block text-xs font-medium text-slate-500">Password</label>
							<input type="password" name="password" autofocus required autocomplete="current-password"
								class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:ring-teal-500"/>
						</div>
						<button class="w-full px-3 py-2 bg-teal-700 text-white text-sm rounded-md hover:bg-teal-800">Sign in</button>
					</form>
				</div>
			</div>
		</body>
	</html>
}
