package view

import "github.com/tylersriver/mend/internal/store"

// Layout is the app shell: mobile-first, htmx + Tailwind via CDN (no build step,
// matching the design's "installable + online is fine" stance). The PWA manifest
// and service worker are deliberately deferred to a later phase.
templ Layout(title string, profile store.CaseProfile) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#0f766e"/>
			<title>{ title } · mend</title>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="icon" href="/static/icon-192.png"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="mend"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script>
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', function () {
						navigator.serviceWorker.register('/sw.js').catch(function () {});
					});
				}
			</script>
		</head>
		<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
			<header class="bg-teal-700 text-white">
				<div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
					<a href="/" class="font-semibold text-lg tracking-tight">mend</a>
					if profile.InjuryName != "" {
						<span class="text-teal-100 text-sm truncate ml-3">{ profile.InjuryName }</span>
					}
				</div>
				<nav class="max-w-3xl mx-auto px-2 flex gap-1 text-sm overflow-x-auto">
					@navLink("/", "Dashboard")
					@navLink("/appointments", "Appointments")
					@navLink("/recordings", "Recordings")
					@navLink("/resources", "Research")
					@navLink("/providers", "Providers")
					@navLink("/pt", "PT")
					@navLink("/settings", "Settings")
				</nav>
			</header>
			<main class="max-w-3xl mx-auto w-full px-4 py-6 flex-1">
				{ children... }
			</main>
			<footer class="max-w-3xl mx-auto w-full px-4 py-6 text-xs text-slate-400">
				Personal care-prep tool · not medical advice.
			</footer>
		</body>
	</html>
}

templ navLink(href, text string) {
	<a href={ templ.SafeURL(href) } class="px-3 py-2 rounded-t-md hover:bg-teal-600 whitespace-nowrap">{ text }</a>
}

// pageHeader is a small reusable heading with an optional action slot.
templ pageHeader(title string) {
	<div class="flex items-center justify-between mb-4">
		<h1 class="text-xl font-semibold text-slate-900">{ title }</h1>
		<div class="flex gap-2">
			{ children... }
		</div>
	</div>
}

templ btnLink(href, text string) {
	<a href={ templ.SafeURL(href) } class="inline-flex items-center px-3 py-2 bg-teal-700 text-white text-sm rounded-md hover:bg-teal-800">{ text }</a>
}

// card is a generic white panel.
templ card() {
	<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-4">
		{ children... }
	</div>
}

// flash renders an inline error/notice fragment (also returned standalone over htmx).
templ flash(kind, msg string) {
	if kind == "error" {
		<div class="rounded-md bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2">{ msg }</div>
	} else {
		<div class="rounded-md bg-amber-50 border border-amber-200 text-amber-800 text-sm px-3 py-2">{ msg }</div>
	}
}
