package view

import "github.com/tylersriver/mend/internal/store"

// SettingsStatus carries the resolved/effective state for the settings page so it
// can show what's active without ever echoing a secret back to the browser.
type SettingsStatus struct {
	AIEnabled                bool
	TranscribeEnabled        bool
	AuthEnabled              bool
	EnvAIKey                 bool // an AI key is provided via env (fallback)
	EnvTranscribeKey         bool
	AIModelDefault           string
	AIBaseURLDefault         string
	TranscribeBaseURLDefault string
	TranscribeModelDefault   string
	Saved                    bool
}

templ SettingsPage(profile store.CaseProfile, set store.Settings, st SettingsStatus) {
	@Layout("Settings", profile) {
		@pageHeader("Settings") {
		}
		if st.Saved {
			<div class="mb-4">
				@flash("warn", "Saved. AI and transcription were reconfigured live.")
			</div>
		}
		<section class="mb-6">
			@card() {
				<h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-3">AI &amp; transcription</h2>
				<div class="flex gap-2 mb-4 text-xs">
					@statusPill("AI", st.AIEnabled)
					@statusPill("Transcription", st.TranscribeEnabled)
				</div>
				<form method="post" action="/settings" class="space-y-4">
					<div>
						<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">AI API key</label>
						<input type="password" name="anthropic_api_key" autocomplete="off"
							placeholder={ keyPlaceholder(set.AnthropicAPIKey, st.EnvAIKey) } class={ inputCls }/>
						<label class="inline-flex items-center gap-1 mt-1 text-xs text-slate-500 dark:text-slate-400">
							<input type="checkbox" name="clear_anthropic" value="1"/> clear saved key
						</label>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						<div class="flex-1 min-w-0">
							<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">AI base URL</label>
							<input name="ai_base_url" value={ set.AIBaseURL } placeholder={ aiBaseURLHint(st.AIBaseURLDefault) } class={ inputCls }/>
						</div>
						<div class="flex-1 min-w-0">
							<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">AI model</label>
							<input name="ai_model" value={ set.AIModel } placeholder={ st.AIModelDefault } class={ inputCls }/>
						</div>
					</div>
					<p class="text-xs text-slate-400 dark:text-slate-500">
						Leave the base URL blank for Anthropic. To use Groq, set it to
						<code>https://api.groq.com/openai/v1</code> with a Groq API key and a Groq
						model (e.g. <code>llama-3.3-70b-versatile</code>). Any OpenAI-compatible
						<code>/chat/completions</code> endpoint works.
					</p>
					<hr class="border-slate-100 dark:border-slate-800"/>
					<div>
						<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Transcription API key</label>
						<input type="password" name="transcribe_api_key" autocomplete="off"
							placeholder={ keyPlaceholder(set.TranscribeAPIKey, st.EnvTranscribeKey) } class={ inputCls }/>
						<label class="inline-flex items-center gap-1 mt-1 text-xs text-slate-500 dark:text-slate-400">
							<input type="checkbox" name="clear_transcribe" value="1"/> clear saved key
						</label>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						<div class="flex-1 min-w-0">
							<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Transcription base URL</label>
							<input name="transcribe_base_url" value={ set.TranscribeBaseURL } placeholder={ st.TranscribeBaseURLDefault } class={ inputCls }/>
						</div>
						<div class="flex-1 min-w-0">
							<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Transcription model</label>
							<input name="transcribe_model" value={ set.TranscribeModel } placeholder={ st.TranscribeModelDefault } class={ inputCls }/>
						</div>
					</div>
					<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Save</button>
				</form>
				<p class="text-xs text-slate-400 dark:text-slate-500 mt-3">
					Keys are stored in your SQLite database (not echoed back here). Leave a key
					field blank to keep the saved value; environment variables act as a fallback.
				</p>
			}
		</section>
		<section>
			@card() {
				<h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Access</h2>
				if st.AuthEnabled {
					<p class="text-sm text-slate-600 dark:text-slate-300 mb-3">Login is required. Set via the <code>AUTH_PASSWORD</code> environment variable.</p>
					<form method="post" action="/logout">
						<button class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm font-medium rounded-xl hover:bg-slate-200 dark:hover:bg-slate-700 active:scale-[.98] transition">Log out</button>
					</form>
				} else {
					@flash("warn", "No login is set. Set AUTH_PASSWORD (and ideally SESSION_SECRET) before exposing this on the internet.")
				}
			}
		</section>
	}
}

templ statusPill(label string, on bool) {
	if on {
		<span class="px-2 py-0.5 rounded-full bg-green-100 text-green-800">{ label }: on</span>
	} else {
		<span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">{ label }: off</span>
	}
}
