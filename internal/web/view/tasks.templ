package view

import "github.com/tylersriver/mend/internal/store"

templ TasksPage(profile store.CaseProfile, tasks []store.Task) {
	@Layout("Tasks", profile) {
		@pageHeader("Tasks") {
		}
		@card() {
			<form
				hx-post="/tasks"
				hx-target="#task-list"
				hx-swap="afterbegin"
				hx-on::after-request="this.reset(); var e=document.getElementById('task-empty'); if(e) e.remove();"
				class="flex gap-2 items-end"
			>
				<input name="title" required autocomplete="off" placeholder="Add a task — e.g. call to schedule PT" class={ inputCls }/>
				<button class="shrink-0 px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Add</button>
			</form>
		}
		<ul id="task-list" class="mt-4 space-y-2">
			for _, t := range tasks {
				@TaskRow(t)
			}
			if len(tasks) == 0 {
				<li id="task-empty" class="text-sm text-slate-400 dark:text-slate-500 px-1">No tasks yet — add one above.</li>
			}
		</ul>
	}
}

// TaskRow is one to-do item; also returned standalone over htmx on add/toggle.
templ TaskRow(t store.Task) {
	<li id={ "task-" + itoa(t.ID) } class="flex items-center gap-3 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-3">
		<button
			hx-post={ taskURL(t.ID) + "/toggle" }
			hx-target="closest li"
			hx-swap="outerHTML"
			aria-label="Toggle done"
			class="shrink-0 text-teal-600 dark:text-teal-400"
		>
			if t.Done {
				<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.1 14.3-3.6-3.6 1.4-1.4 2.2 2.2 4.9-4.9 1.4 1.4-6.3 6.3z"></path>
				</svg>
			} else {
				<svg class="w-6 h-6 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="9"></circle>
				</svg>
			}
		</button>
		<span class={ "flex-1 text-sm " + doneCls(t.Done) }>{ t.Title }</span>
		<button
			hx-post={ taskURL(t.ID) + "/delete" }
			hx-target="closest li"
			hx-swap="outerHTML"
			aria-label="Delete task"
			class="shrink-0 text-slate-300 dark:text-slate-600 hover:text-red-500 transition"
		>
			<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</li>
}
