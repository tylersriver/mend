package view

import "github.com/tylersriver/mend/internal/store"

templ ProtocolList(profile store.CaseProfile, protocols []store.Protocol) {
	@Layout("Protocols", profile) {
		@pageHeader("Protocols") {
			@btnLink("/pt/protocols/new", "+ New phase")
		}
		<p class="text-sm text-slate-400 dark:text-slate-500 mb-4">
			A protocol is a rehab phase with prescribed exercises. New sessions are
			automatically linked to the active phase so you can compare plan vs. performed.
		</p>
		if len(protocols) == 0 {
			<p class="text-sm text-slate-400 dark:text-slate-500">No protocols yet.</p>
		} else {
			<ul class="space-y-2">
				for _, p := range protocols {
					<li>
						<a href={ templ.SafeURL(ptURL("protocols", p.ID)) } class="block bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-3 hover:border-teal-300 dark:hover:border-teal-700">
							<div class="flex justify-between items-center">
								<span class="font-medium">{ p.Name }</span>
								@protocolPill(p)
							</div>
							<div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
								{ humanTime(p.StartedOn) }
								if p.EndedOn != "" {
									<span> → { humanTime(p.EndedOn) }</span>
								}
								<span> · { itoaInt(p.ExerciseCount) } exercises</span>
							</div>
						</a>
					</li>
				}
			</ul>
		}
	}
}

templ protocolPill(p store.Protocol) {
	if p.Active() {
		<span class="text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-800">active</span>
	} else {
		<span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">ended</span>
	}
}

templ ProtocolForm(profile store.CaseProfile) {
	@Layout("New protocol", profile) {
		@pageHeader("New protocol") {
		}
		@card() {
			<form method="post" action="/pt/protocols" class="space-y-4">
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Name</label>
					<input name="name" required placeholder="Phase 1 – Conservative" class={ inputCls }/>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Start date</label>
					<input type="date" name="started_on" class={ inputCls }/>
					<p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Leave blank for today. Starting a new phase doesn't end older ones automatically.</p>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Notes</label>
					<textarea name="notes" rows="2" class={ inputCls }></textarea>
				</div>
				<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Create</button>
			</form>
		}
	}
}

templ ProtocolDetail(profile store.CaseProfile, p store.Protocol, rows []ComplianceRow, exercises []store.Exercise) {
	@Layout(p.Name, profile) {
		<div class="flex items-center justify-between mb-1">
			<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ p.Name }</h1>
			@protocolPill(p)
		</div>
		<p class="text-sm text-slate-500 dark:text-slate-400 mb-4">
			{ humanTime(p.StartedOn) }
			if p.EndedOn != "" {
				<span> → { humanTime(p.EndedOn) }</span>
			}
		</p>
		if p.Notes != "" {
			<div class="mb-4">
				@card() {
					<p class="text-sm whitespace-pre-wrap">{ p.Notes }</p>
				}
			</div>
		}
		<div class="flex gap-2 mb-6">
			if p.Active() {
				<form method="post" action={ templ.SafeURL(ptURL("protocols", p.ID) + "/end") } onsubmit="return confirm('End this phase?')">
					<button class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm font-medium rounded-xl hover:bg-slate-200 dark:hover:bg-slate-700 active:scale-[.98] transition">End phase</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(ptURL("protocols", p.ID) + "/delete") } onsubmit="return confirm('Delete this protocol and its prescription?')">
				<button class="px-3 py-2 text-red-600 text-sm underline">Delete</button>
			</form>
		</div>
		<section class="mb-6">
			<h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Prescription vs. logged</h2>
			if len(rows) == 0 {
				<p class="text-sm text-slate-400 dark:text-slate-500 mb-3">No exercises prescribed yet.</p>
			} else {
				<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden mb-4">
					<table class="w-full text-sm">
						<tbody>
							for _, row := range rows {
								<tr class="border-t border-slate-100 dark:border-slate-800 first:border-t-0 align-top">
									<td class="px-3 py-2">
										<div class="font-medium">{ row.PE.ExerciseName }</div>
										<div class="text-xs text-teal-700 dark:text-teal-400">target: { targetSummary(row.PE) }</div>
										if row.PE.Frequency != "" {
											<div class="text-xs text-slate-400 dark:text-slate-500">{ row.PE.Frequency }</div>
										}
										if row.PE.Progression != "" {
											<div class="text-xs text-slate-400 dark:text-slate-500">progress: { row.PE.Progression }</div>
										}
										<div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
											if row.Logged {
												last logged: { setSummary(row.Last) }
											} else {
												<span class="text-slate-400 dark:text-slate-500">not logged yet this phase</span>
											}
										</div>
									</td>
									<td class="px-3 py-2 text-right">
										<form method="post" action={ templ.SafeURL(protoExURL(row.PE.ID)) }>
											<button class="text-xs text-red-600 underline">remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			if len(exercises) == 0 {
				<p class="text-sm text-slate-400 dark:text-slate-500">Add an <a href="/pt/exercises/new" class="underline">exercise</a> first to prescribe it.</p>
			} else {
				@addPrescriptionForm(p.ID, exercises)
			}
		</section>
	}
}

templ addPrescriptionForm(protocolID int64, exercises []store.Exercise) {
	<form method="post" action={ templ.SafeURL(ptURL("protocols", protocolID) + "/exercises") } class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-3 space-y-3">
		<div>
			<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Prescribe exercise</label>
			<select name="exercise_id" class={ inputCls }>
				for _, e := range exercises {
					<option value={ itoa(e.ID) }>{ e.Name }</option>
				}
			</select>
		</div>
		<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Sets</label>
				<input type="number" name="target_sets" min="0" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Reps</label>
				<input type="number" name="target_reps" min="0" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Load (lb)</label>
				<input type="number" name="target_load" step="0.5" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Hold (s)</label>
				<input type="number" name="target_duration_sec" min="0" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">RPE</label>
				<input type="number" name="target_rpe" step="0.5" min="0" max="10" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Order</label>
				<input type="number" name="sort_order" min="0" value="0" class={ inputCls }/>
			</div>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Frequency</label>
				<input name="frequency" placeholder="daily · 3x/week" class={ inputCls }/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Progression</label>
				<input name="progression" placeholder="add 1 rep when RPE<6" class={ inputCls }/>
			</div>
		</div>
		<button class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl shadow-sm shadow-teal-600/20 hover:bg-teal-700 active:scale-[.98] transition">Add to protocol</button>
	</form>
}
